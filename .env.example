# Copy to .env.local. Never commit actual credentials.
APP_PASSWORD=
# Minimum 32 random characters; changing it invalidates all sessions.
SESSION_SECRET=
# Server-only credential for scoped machine/operator API access. Never expose to browser code.
AGENT_OPERATOR_SECRET=
# Self-hosted database path (preferred in production).
DATABASE_API_URL=http://cacadores-postgrest:3000
DATABASE_SERVICE_ROLE_KEY=
# 32-byte base64/hex key used to encrypt provider credentials in PostgreSQL.
PROVIDER_SECRETS_KEY=
# Legacy Supabase values remain only as a temporary migration fallback.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
# Transitional object storage provider. New objects are isolated under the Caçadores prefix.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_KEY_PREFIX=cacadores/
# Provider keys above are optional fallbacks. In self-hosted mode the operator
# can validate and store them from Configurações; values are encrypted in PostgreSQL.
# Set true only after confirming YouTube acceptance for this actual use case.
YOUTUBE_ANALYTICS_APPROVED=false
# Minimum 32 random characters. Cron is intentionally not scheduled by default.
CRON_SECRET=
# Secret and internal URL for the self-hosted Production Autonomy worker.
PRODUCTION_AUTONOMY_WORKER_SECRET=
PRODUCTION_AUTONOMY_WORKER_URL=
PRODUCTION_AUTONOMY_WORKER_POLL_MS=5000
