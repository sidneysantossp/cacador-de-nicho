# Copy to .env.local. Never commit actual credentials.
APP_PASSWORD=
# Minimum 32 random characters; changing it invalidates all sessions.
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
OPENAI_API_KEY=
# Provider keys above are optional fallbacks. After Supabase is ready, the operator
# can validate and store them from Configurações; values are encrypted in Vault.
# Set true only after confirming YouTube acceptance for this actual use case.
YOUTUBE_ANALYTICS_APPROVED=false
# Minimum 32 random characters. Cron is intentionally not scheduled by default.
CRON_SECRET=
