[Unit]
Description=Caçadores Production Autonomy worker
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/srv/auditseo-deploy/bin/cacadores-production-autonomy-worker-sync
KillMode=control-group
KillSignal=SIGTERM
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=20s
SuccessExitStatus=0 143

[Install]
WantedBy=multi-user.target
