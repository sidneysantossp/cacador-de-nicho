#!/usr/bin/env bash
set -euo pipefail

BASE=/srv/auditseo-deploy
PROJECT=cacador-de-nicho
STATE_FILE="$BASE/state/$PROJECT.json"
ENV_FILE="$BASE/env/$PROJECT.production.env"
WORK_DIR="$BASE/work/$PROJECT-production-autonomy"
CONTAINER="$PROJECT-production-autonomy-worker"

CHILD_PID=""
stopping=0
cleanup() {
  if [[ "$stopping" -eq 0 && -n "$CHILD_PID" ]]; then
    stopping=1
    kill -TERM "$CHILD_PID" >/dev/null 2>&1 || true
    wait "$CHILD_PID" >/dev/null 2>&1 || true
  fi
  docker stop --time 10 "$CONTAINER" >/dev/null 2>&1 || true
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
}
on_signal() {
  stopping=1
  [[ -n "$CHILD_PID" ]] && kill -TERM "$CHILD_PID" >/dev/null 2>&1 || true
}
trap on_signal INT TERM
trap cleanup EXIT

readarray -t VALUES < <(python3 - "$STATE_FILE" <<'PY'
from pathlib import Path
import json,sys
s=json.loads(Path(sys.argv[1]).read_text())
prod=s.get("production") or {}
print(prod.get("image", ""))
PY
)
IMAGE="${VALUES[0]:-}"
[[ -n "$IMAGE" ]] || { echo "production state incomplete" >&2; exit 1; }
[[ -f "$ENV_FILE" ]] || { echo "production env missing" >&2; exit 1; }

mkdir -p "$WORK_DIR"
chown 1001:1001 "$WORK_DIR"
cleanup
docker run --rm \
  --name "$CONTAINER" \
  --env-file "$ENV_FILE" \
  --memory 512m \
  --cpus 0.5 \
  --pids-limit 128 \
  -v "$WORK_DIR:/tmp" \
  --label auditseo.role=production-autonomy-worker \
  "$IMAGE" node scripts/production-autonomy-worker.mjs &
CHILD_PID=$!
wait "$CHILD_PID"
