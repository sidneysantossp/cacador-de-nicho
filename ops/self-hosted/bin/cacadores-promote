#!/usr/bin/env bash
set -euo pipefail

BASE=/srv/auditseo-deploy
PROJECT=cacador-de-nicho
ROOT="$BASE/projects/$PROJECT/source"
REPO=https://github.com/sidneysantossp/cacador-de-nicho.git
ENV_FILE="$BASE/env/$PROJECT.production.env"
STATE_FILE="$BASE/state/$PROJECT.json"
LOG_DIR="$BASE/logs/$PROJECT"
LEGACY_PGP_HOST="$BASE/secrets/cacadores-migration-pgp-passphrase"
LEGACY_PGP_RUNTIME="$BASE/secrets/cacadores-migration-pgp-passphrase.runtime"
SHA="${1:-}"

ensure_production_autonomy_env() {
  touch "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  if ! grep -Eq '^PRODUCTION_AUTONOMY_WORKER_SECRET=[^[:space:]]{32,}$' "$ENV_FILE"; then
    sed -i '/^PRODUCTION_AUTONOMY_WORKER_SECRET=/d' "$ENV_FILE"
    printf 'PRODUCTION_AUTONOMY_WORKER_SECRET=%s\n' "$(python3 -c 'import secrets; print(secrets.token_hex(32))')" >> "$ENV_FILE"
  fi
  if ! grep -Eq '^PRODUCTION_AUTONOMY_WORKER_URL=https://cacadores\.159\.198\.40\.98\.sslip\.io/api/workers/production-autonomy$' "$ENV_FILE"; then
    sed -i '/^PRODUCTION_AUTONOMY_WORKER_URL=/d' "$ENV_FILE"
    printf '%s\n' 'PRODUCTION_AUTONOMY_WORKER_URL=https://cacadores.159.198.40.98.sslip.io/api/workers/production-autonomy' >> "$ENV_FILE"
  fi
  if ! grep -Eq '^PRODUCTION_AUTONOMY_WORKER_POLL_MS=[0-9]+$' "$ENV_FILE"; then
    sed -i '/^PRODUCTION_AUTONOMY_WORKER_POLL_MS=/d' "$ENV_FILE"
    printf '%s\n' 'PRODUCTION_AUTONOMY_WORKER_POLL_MS=5000' >> "$ENV_FILE"
  fi
}

if [[ -z "$SHA" ]]; then
  echo "usage: cacadores-promote <commit-sha>" >&2
  exit 64
fi

mkdir -p "$LOG_DIR"
cd "$ROOT"
git fetch --prune origin master
FULL_SHA="$(git rev-parse "$SHA^{commit}")"
SHORT="${FULL_SHA:0:7}"
IMAGE="auditseo/$PROJECT:$SHORT"
ensure_production_autonomy_env

git checkout -f --detach "$FULL_SHA"
git reset --hard "$FULL_SHA"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  DEPLOY_TAG="deploy-$FULL_SHA"
  DEPLOY_ASSET="$PROJECT-$FULL_SHA.tar.gz"
  DEPLOY_BASE_URL="https://github.com/sidneysantossp/cacador-de-nicho/releases/download/$DEPLOY_TAG"
  DEPLOY_TMP_ROOT="$BASE/tmp"
  DEPLOY_TMP="$DEPLOY_TMP_ROOT/deploy-$SHORT-$$"
  FREE_KB="$(df --output=avail -k / | tail -n 1 | tr -d ' ')"
  MIN_FREE_KB=$((6*1024*1024))
  if [[ ! "$FREE_KB" =~ ^[0-9]+$ ]] || (( FREE_KB < MIN_FREE_KB )); then
    echo "insufficient free disk for deploy image: available_kb=$FREE_KB required_kb=$MIN_FREE_KB" >&2
    exit 78
  fi
  mkdir -p "$DEPLOY_TMP"
  cleanup_deploy_tmp(){ rm -rf "$DEPLOY_TMP"; }
  trap cleanup_deploy_tmp EXIT
  if ! curl -fL --retry 3 --retry-all-errors --connect-timeout 15 --max-time 900     -o "$DEPLOY_TMP/$DEPLOY_ASSET" "$DEPLOY_BASE_URL/$DEPLOY_ASSET"; then
    echo "deploy image asset is not ready for sha=$FULL_SHA" >&2
    exit 75
  fi
  curl -fL --retry 3 --retry-all-errors --connect-timeout 15 --max-time 60     -o "$DEPLOY_TMP/$DEPLOY_ASSET.sha256" "$DEPLOY_BASE_URL/$DEPLOY_ASSET.sha256"
  (
    cd "$DEPLOY_TMP"
    sha256sum -c "$DEPLOY_ASSET.sha256"
  )
  gzip -dc "$DEPLOY_TMP/$DEPLOY_ASSET" | docker load >/dev/null
  docker image inspect "$IMAGE" >/dev/null
  cleanup_deploy_tmp
  trap - EXIT
fi

CURRENT_PORT="$(python3 - "$STATE_FILE" <<'PY'
from pathlib import Path
import json,sys
p=Path(sys.argv[1])
if not p.exists():
    print("")
else:
    try:
        s=json.loads(p.read_text())
        print((s.get("production") or {}).get("port",""))
    except Exception:
        print("")
PY
)"

if [[ "$CURRENT_PORT" == "3102" ]]; then CANDIDATE_PORT=3103; else CANDIDATE_PORT=3102; fi
CANDIDATE_CONTAINER="$PROJECT-prod-$CANDIDATE_PORT"

sed -i "s/^APP_COMMIT_SHA=.*/APP_COMMIT_SHA=$FULL_SHA/" "$ENV_FILE"
sed -i "s/^APP_ENVIRONMENT=.*/APP_ENVIRONMENT=production/" "$ENV_FILE"

docker rm -f "$CANDIDATE_CONTAINER" >/dev/null 2>&1 || true
if ! docker network inspect cacadores-infra >/dev/null 2>&1; then
  docker network create --driver bridge cacadores-infra >/dev/null
fi
if ! docker inspect cacadores-postgres >/dev/null 2>&1 || [[ "$(docker inspect -f '{{.State.Running}}' cacadores-postgres 2>/dev/null || true)" != "true" ]]; then
  echo "self-hosted PostgreSQL is not running" >&2
  exit 1
fi
if ! docker inspect cacadores-postgrest >/dev/null 2>&1 || [[ "$(docker inspect -f '{{.State.Running}}' cacadores-postgrest 2>/dev/null || true)" != "true" ]]; then
  echo "self-hosted PostgREST is not running" >&2
  exit 1
fi
# Re-assert self-hosted data-plane resource ceilings on every production promotion.
docker update --memory 768m --memory-swap 1g --cpus 0.75 --pids-limit 256 cacadores-postgres >/dev/null
docker update --memory 256m --memory-swap 384m --cpus 0.25 --pids-limit 128 cacadores-postgrest >/dev/null
if docker inspect cacadores-postgrest-proxy >/dev/null 2>&1; then
  docker update --memory 128m --memory-swap 192m --cpus 0.20 --pids-limit 128 cacadores-postgrest-proxy >/dev/null
fi
if [[ -f "$LEGACY_PGP_HOST" ]]; then
  install -m 0640 -o root -g 1001 "$LEGACY_PGP_HOST" "$LEGACY_PGP_RUNTIME"
  LEGACY_ARGS=(--env "PROVIDER_SECRETS_LEGACY_PGP_PASSPHRASE_FILE=/run/secrets/cacadores-migration-pgp-passphrase" --volume "$LEGACY_PGP_RUNTIME:/run/secrets/cacadores-migration-pgp-passphrase:ro")
else
  LEGACY_ARGS=()
fi
docker run -d --name "$CANDIDATE_CONTAINER" --restart unless-stopped --env-file "$ENV_FILE" --network cacadores-infra --memory 768m --memory-swap 1g --cpus 0.75 --pids-limit 256 -p "127.0.0.1:$CANDIDATE_PORT:3000" "${LEGACY_ARGS[@]}" "$IMAGE" >/dev/null

BODY=""
for i in $(seq 1 30); do
  if BODY="$(curl -fsS "http://127.0.0.1:$CANDIDATE_PORT/api/health" 2>/dev/null)"; then
    if python3 - "$FULL_SHA" "$BODY" <<'PY'
import json,sys
try:
    sha=sys.argv[1]
    b=json.loads(sys.argv[2])
    ok=b.get("ok") is True and b.get("commit")==sha and b.get("databaseConnected") is True
except Exception:
    ok=False
raise SystemExit(0 if ok else 1)
PY
    then
      break
    fi
  fi
  BODY=""
  sleep 1
done

if [[ -z "$BODY" ]]; then
  docker logs "$CANDIDATE_CONTAINER" --tail 100 || true
  docker rm -f "$CANDIDATE_CONTAINER" >/dev/null 2>&1 || true
  echo "candidate health failed" >&2
  exit 1
fi

"$BASE/bin/cacadores-route-production" "$CANDIDATE_PORT"

ROUTE_OK=0
for i in $(seq 1 20); do
  EXT_BODY="$(curl -fsS "https://cacadores.159.198.40.98.sslip.io/api/health" 2>/dev/null || true)"
  if [[ -n "$EXT_BODY" ]] && python3 - "$FULL_SHA" "$EXT_BODY" <<'PYROUTE'
import json,sys
try:
    sha=sys.argv[1]
    b=json.loads(sys.argv[2])
    ok=b.get("ok") is True and b.get("commit")==sha and b.get("databaseConnected") is True
except Exception:
    ok=False
raise SystemExit(0 if ok else 1)
PYROUTE
  then
    ROUTE_OK=1
    break
  fi
  sleep 0.5
done

if [[ "$ROUTE_OK" != 1 ]]; then
  if [[ -n "$CURRENT_PORT" ]]; then
    "$BASE/bin/cacadores-route-production" "$CURRENT_PORT" || true
  fi
  docker rm -f "$CANDIDATE_CONTAINER" >/dev/null 2>&1 || true
  echo "public route validation failed" >&2
  exit 1
fi

python3 - "$STATE_FILE" "$FULL_SHA" "$IMAGE" "$CANDIDATE_PORT" "$CANDIDATE_CONTAINER" <<'PY'
from pathlib import Path
import json,sys,datetime
p=Path(sys.argv[1])
state={}
if p.exists():
    try: state=json.loads(p.read_text())
    except Exception: state={}
old=state.get("production")
if old:
    state["previousProduction"]=old
state["production"]={
    "sha":sys.argv[2],
    "image":sys.argv[3],
    "port":int(sys.argv[4]),
    "container":sys.argv[5],
    "deployedAt":datetime.datetime.now(datetime.timezone.utc).isoformat()
}
state["project"]="cacador-de-nicho"
p.write_text(json.dumps(state,indent=2)+"\n")
PY

if [[ -d "$ROOT/ops/self-hosted/bin" ]]; then
  for FILE in "$ROOT"/ops/self-hosted/bin/*; do
    [[ -f "$FILE" ]] || continue
    install -m 0755 "$FILE" "$BASE/bin/$(basename "$FILE")"
  done
fi
if [[ -d "$ROOT/ops/self-hosted/systemd" ]]; then
  for FILE in "$ROOT"/ops/self-hosted/systemd/*; do
    [[ -f "$FILE" ]] || continue
    install -m 0644 "$FILE" "/etc/systemd/system/$(basename "$FILE")"
  done
  systemctl daemon-reload
  MODE_FILE="$BASE/state/cacador-de-nicho-operation-mode.json"
  RENDER_BACKEND_FILE="$BASE/state/cacador-de-nicho-render-backend.json"
  OPERATION_MODE="$(python3 - "$MODE_FILE" <<'PYMODE'
from pathlib import Path
import json,sys
p=Path(sys.argv[1])
mode=""
if p.exists():
    try: mode=str(json.loads(p.read_text()).get("mode",""))
    except Exception: pass
print(mode)
PYMODE
)"
  RENDER_BACKEND="$(python3 - "$RENDER_BACKEND_FILE" <<'PYRENDER'
from pathlib import Path
import json,sys
p=Path(sys.argv[1])
value=""
if p.exists():
    try: value=str(json.loads(p.read_text()).get("backend",""))
    except Exception: pass
print(value)
PYRENDER
)"
  BACKGROUND_HOLD=0
  if [[ -f "$BASE/state/cacador-de-nicho-maintenance-hold" || -f "$BASE/state/cacador-de-nicho-resource-hold.json" ]]; then
    BACKGROUND_HOLD=1
  fi
  for FILE in "$ROOT"/ops/self-hosted/systemd/*.timer; do
    [[ -f "$FILE" ]] || continue
    TIMER="$(basename "$FILE")"
    if (( BACKGROUND_HOLD == 1 )) && [[ "$TIMER" != "cacadores-auto-deploy.timer" && "$TIMER" != "cacadores-health-watch.timer" && "$TIMER" != "cacadores-db-backup.timer" ]]; then
      systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
      continue
    fi
    if [[ "$RENDER_BACKEND" == "github-actions" && "$TIMER" == "cacadores-render-worker-sync.timer" ]]; then
      systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
      continue
    fi
    if [[ "$OPERATION_MODE" == "assisted-manual" ]] && [[ "$TIMER" == "cacadores-universe-cycle.timer" || "$TIMER" == "cacadores-market-intelligence.timer" || "$TIMER" == "cacadores-youtube-publish-worker-sync.timer" ]]; then
      systemctl disable --now "$TIMER" >/dev/null 2>&1 || true
      continue
    fi
    systemctl enable "$TIMER" >/dev/null 2>&1 || true
    if [[ "$TIMER" == "cacadores-auto-deploy.timer" ]]; then
      # Never restart the timer that triggered this promotion while its service is still running.
      continue
    fi
    systemctl restart "$TIMER" >/dev/null 2>&1 || true
  done
  systemctl reset-failed cacadores-universe-batch.service >/dev/null 2>&1 || true
fi

echo "PROMOTED sha=$FULL_SHA port=$CANDIDATE_PORT"
echo "$BODY"
