#!/usr/bin/env bash
set -euo pipefail

BASE=/srv/auditseo-deploy
PROJECT=cacador-de-nicho
STATE_FILE="$BASE/state/$PROJECT.json"
WORKER_STATE="$BASE/state/$PROJECT-youtube-publish-worker.json"
ENV_FILE="$BASE/env/$PROJECT.production.env"
WORK_DIR="$BASE/work/$PROJECT-youtube-publish"
CONTAINER="$PROJECT-youtube-publish-worker"
LOCK_DIR="$BASE/state/.cacadores-youtube-publish-worker-sync.lock"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" >/dev/null 2>&1 || true' EXIT

[[ -f "$ENV_FILE" ]] || {
  echo "production env file missing: $ENV_FILE" >&2
  exit 1
}

MISSING_JSON="$(python3 - "$ENV_FILE" <<'PY'
from pathlib import Path
import json,sys
values={}
for raw in Path(sys.argv[1]).read_text(errors="ignore").splitlines():
    line=raw.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    key,value=line.split("=",1)
    values[key.strip()]=value.strip().strip('"').strip("'")
required=[
    "DATABASE_API_URL",
    "DATABASE_SERVICE_ROLE_KEY",
    "YOUTUBE_OAUTH_CLIENT_ID",
    "YOUTUBE_OAUTH_CLIENT_SECRET",
]
missing=[key for key in required if not values.get(key)]
if len(values.get("YOUTUBE_TOKEN_ENCRYPTION_KEY","")) < 32:
    missing.append("YOUTUBE_TOKEN_ENCRYPTION_KEY")
print(json.dumps(missing))
PY
)"

if [[ "$MISSING_JSON" != "[]" ]]; then
  python3 - "$WORKER_STATE" "$MISSING_JSON" <<'PY'
from pathlib import Path
import datetime,json,sys
Path(sys.argv[1]).write_text(json.dumps({
  "status":"blocked",
  "reason":"oauth-config",
  "missing":json.loads(sys.argv[2]),
  "checkedAt":datetime.datetime.now(datetime.timezone.utc).isoformat()
},indent=2)+"\n")
PY
  echo "YOUTUBE_PUBLISH_WORKER_BLOCKED missing=$MISSING_JSON"
  exit 0
fi

IFS=$'\t' read -r SHA IMAGE < <(python3 - "$STATE_FILE" <<'PY'
from pathlib import Path
import json,sys
s=json.loads(Path(sys.argv[1]).read_text())
prod=s.get("production") or {}
print(str(prod.get("sha",""))+"\t"+str(prod.get("image","")))
PY
)
[[ -n "$SHA" && -n "$IMAGE" ]] || { echo "production state incomplete" >&2; exit 1; }

CURRENT_SHA="$(docker inspect "$CONTAINER" --format '{{index .Config.Labels "auditseo.youtube-publish.sha"}}' 2>/dev/null || true)"
RUNNING="$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)"
MEMORY="$(docker inspect "$CONTAINER" --format '{{.HostConfig.Memory}}' 2>/dev/null || true)"
CPUS="$(docker inspect "$CONTAINER" --format '{{.HostConfig.NanoCpus}}' 2>/dev/null || true)"

TARGET_MEMORY=402653184
TARGET_CPUS=350000000

if [[ "$CURRENT_SHA" == "$SHA" && "$RUNNING" == "true" && "$MEMORY" == "$TARGET_MEMORY" && "$CPUS" == "$TARGET_CPUS" ]]; then
  exit 0
fi

mkdir -p "$WORK_DIR"
chown 1001:1001 "$WORK_DIR"
docker rm -f "$CONTAINER" >/dev/null 2>&1 || true

docker run -d \
  --name "$CONTAINER" \
  --restart unless-stopped \
  --env-file "$ENV_FILE" \
  -e YOUTUBE_PUBLISH_WORKER_POLL_MS=30000 \
  --cgroup-parent=cacadores-workers.slice \
  --memory 384m \
  --memory-swap 512m \
  --cpus 0.35 \
  --pids-limit 192 \
  -v "$WORK_DIR:/tmp" \
  --label auditseo.role=youtube-publish-worker \
  --label "auditseo.youtube-publish.sha=$SHA" \
  "$IMAGE" node scripts/youtube-publish-worker.mjs >/dev/null

for i in $(seq 1 30); do
  [[ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] && break
  sleep 0.5
done

[[ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] || {
  docker logs "$CONTAINER" --tail 100 || true
  exit 1
}

python3 - "$WORKER_STATE" "$SHA" "$IMAGE" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({
  "status":"running",
  "sha":sys.argv[2],
  "image":sys.argv[3],
  "container":"cacador-de-nicho-youtube-publish-worker",
  "memoryBytes":402653184,
  "nanoCpus":350000000,
  "syncedAt":datetime.datetime.now(datetime.timezone.utc).isoformat()
},indent=2)+"\n")
PY

echo "YOUTUBE_PUBLISH_WORKER_SYNCED sha=$SHA image=$IMAGE memory=384m cpus=0.35"
