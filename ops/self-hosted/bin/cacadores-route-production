#!/usr/bin/env bash
set -euo pipefail
PORT="${1:-}"
case "$PORT" in 3102|3103) ;; *) echo "invalid production port" >&2; exit 64;; esac
DOMAIN=cacadores.159.198.40.98.sslip.io
ROOT=/www/wwwroot/$DOMAIN
WELL=/www/server/panel/vhost/nginx/well-known/$DOMAIN.conf
CONF=/www/server/panel/vhost/nginx/$DOMAIN.conf
CERTDIR=/www/server/panel/vhost/cert/$DOMAIN

cat > "$CONF" <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $DOMAIN;
    root $ROOT;
    include $WELL;
    location / { return 301 https://\$host\$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name $DOMAIN;
    ssl_certificate $CERTDIR/fullchain.pem;
    ssl_certificate_key $CERTDIR/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CACADORES_PROD_SSL:10m;
    ssl_session_timeout 10m;
    add_header Strict-Transport-Security "max-age=86400" always;

    client_max_body_size 2048m;
    client_body_timeout 1800s;

    include $WELL;

    location / {
        proxy_cache off;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:$PORT;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
    }

    access_log /www/wwwlogs/$DOMAIN.log;
    error_log /www/wwwlogs/$DOMAIN.error.log;
}
EOF

/www/server/nginx/sbin/nginx -t -c /www/server/nginx/conf/nginx.conf
systemctl reload nginx
