#!/usr/bin/env bash
set -uo pipefail
BASE=/srv/auditseo-deploy
STATE="$BASE/state/cacador-de-nicho.json"
WATCH="$BASE/state/cacador-de-nicho-health-watch.json"
PUBLIC=https://cacadores.159.198.40.98.sslip.io/api/health

# Keep infrastructure schedulers alive. Editorial/market schedulers are only
# self-healed when the operation is not in assisted-manual mode.
MODE_FILE="$BASE/state/cacador-de-nicho-operation-mode.json"
OPERATION_MODE="$(python3 - "$MODE_FILE" <<'PYMODE'
from pathlib import Path
import json,sys
p=Path(sys.argv[1])
mode=""
if p.exists():
    try: mode=str(json.loads(p.read_text()).get("mode",""))
    except Exception: pass
print(mode)
PYMODE
)"
UNITS=(
  cacadores-auto-deploy.timer
  cacadores-episode-automation-worker-sync.timer
  cacadores-owned-visual-worker-sync.timer
  cacadores-verified-stock-worker-sync.timer
)
if [[ "$OPERATION_MODE" != "assisted-manual" ]]; then
  UNITS+=(cacadores-universe-cycle.timer cacadores-market-intelligence.timer)
fi
for UNIT in "${UNITS[@]}"; do
  if ! systemctl is-enabled --quiet "$UNIT"; then
    systemctl enable "$UNIT" >/dev/null 2>&1 || true
  fi
  if ! systemctl is-active --quiet "$UNIT"; then
    systemctl start "$UNIT" >/dev/null 2>&1 || true
  fi
done

readarray -t V < <(python3 - "$STATE" <<'PY'
from pathlib import Path
import json,sys
s=json.loads(Path(sys.argv[1]).read_text())
p=s.get('production') or {}; q=s.get('previousProduction') or {}
print(p.get('sha','')); print(p.get('port','')); print(q.get('sha','')); print(q.get('port',''))
PY
)
PROD_SHA="${V[0]:-}"; PROD_PORT="${V[1]:-}"; PREV_SHA="${V[2]:-}"; PREV_PORT="${V[3]:-}"
[[ -n "$PROD_SHA" && -n "$PROD_PORT" ]] || exit 0

PUBLIC_BODY="$(curl -fsS --max-time 10 "$PUBLIC" 2>/dev/null || true)"
DIRECT_BODY="$(curl -fsS --max-time 10 "http://127.0.0.1:$PROD_PORT/api/health" 2>/dev/null || true)"

CURRENT_OK=0
if [[ -n "$PUBLIC_BODY" && -n "$DIRECT_BODY" ]]; then
  if python3 - "$PROD_SHA" "$PUBLIC_BODY" "$DIRECT_BODY" <<'PY' >/dev/null 2>&1
import json,sys
sha=sys.argv[1]
try:
    a=json.loads(sys.argv[2]); b=json.loads(sys.argv[3])
    ok=a.get('ok') is True and b.get('ok') is True and a.get('commit')==sha and b.get('commit')==sha
except Exception: ok=False
raise SystemExit(0 if ok else 1)
PY
  then CURRENT_OK=1; fi
fi

if [[ "$CURRENT_OK" == 1 ]]; then
  python3 - "$WATCH" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({'consecutiveFailures':0,'lastHealthyAt':datetime.datetime.now(datetime.timezone.utc).isoformat()},indent=2)+'\n')
PY
  exit 0
fi

FAILURES="$(python3 - "$WATCH" <<'PY'
from pathlib import Path
import json,sys
p=Path(sys.argv[1]); n=0
if p.exists():
    try: n=int(json.loads(p.read_text()).get('consecutiveFailures',0))
    except Exception: pass
print(n+1)
PY
)"
python3 - "$WATCH" "$FAILURES" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({'consecutiveFailures':int(sys.argv[2]),'lastFailureAt':datetime.datetime.now(datetime.timezone.utc).isoformat()},indent=2)+'\n')
PY

[[ "$FAILURES" -ge 3 ]] || exit 0
[[ -n "$PREV_SHA" && -n "$PREV_PORT" ]] || exit 0

PREV_BODY="$(curl -fsS --max-time 10 "http://127.0.0.1:$PREV_PORT/api/health" 2>/dev/null || true)"
if [[ -z "$PREV_BODY" ]]; then exit 0; fi
if ! python3 - "$PREV_SHA" "$PREV_BODY" <<'PY' >/dev/null 2>&1
import json,sys
try:
    b=json.loads(sys.argv[2]); ok=b.get('ok') is True and b.get('commit')==sys.argv[1]
except Exception: ok=False
raise SystemExit(0 if ok else 1)
PY
then exit 0; fi

"$BASE/bin/cacadores-rollback" >/dev/null 2>&1 || exit 1
python3 - "$WATCH" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({'consecutiveFailures':0,'autoRollbackAt':datetime.datetime.now(datetime.timezone.utc).isoformat()},indent=2)+'\n')
PY
