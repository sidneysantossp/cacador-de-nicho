#!/usr/bin/env bash
set -euo pipefail

BASE=/srv/auditseo-deploy
PROJECT=cacador-de-nicho
STATE_FILE="$BASE/state/$PROJECT.json"
WORKER_STATE="$BASE/state/$PROJECT-verified-stock-worker.json"
ENV_FILE="$BASE/env/$PROJECT.production.env"
WORK_DIR="$BASE/work/$PROJECT-verified-stock"
CONTAINER="$PROJECT-verified-stock-worker"
LOCK_DIR="$BASE/state/.cacadores-verified-stock-worker-sync.lock"

TARGET_MEMORY=2147483648
TARGET_CPUS=1000000000
FAST_MEMORY=335544320
FAST_CPUS=350000000
FAST_WORKERS="${VERIFIED_STOCK_FAST_WORKERS:-5}"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" >/dev/null 2>&1 || true' EXIT

readarray -t VALUES < <(python3 - "$STATE_FILE" "$ENV_FILE" <<'PY'
from pathlib import Path
import json,sys
s=json.loads(Path(sys.argv[1]).read_text())
prod=s.get("production") or {}
env={}
for raw in Path(sys.argv[2]).read_text().splitlines():
    line=raw.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    key,value=line.split("=",1)
    env[key.strip()]=value.strip()
print(prod.get("sha",""))
print(prod.get("image",""))
print(env.get("AUTOMATION_WORKER_URL",""))
PY
)
SHA="${VALUES[0]:-}"
IMAGE="${VALUES[1]:-}"
FAST_WORKER_URL="${VALUES[2]:-}"
[[ -n "$SHA" && -n "$IMAGE" ]] || { echo "production state incomplete" >&2; exit 1; }
[[ "$FAST_WORKERS" =~ ^[0-9]+$ ]] || { echo "VERIFIED_STOCK_FAST_WORKERS must be an integer" >&2; exit 1; }
(( FAST_WORKERS>=0 && FAST_WORKERS<=8 )) || { echo "VERIFIED_STOCK_FAST_WORKERS must be between 0 and 8" >&2; exit 1; }
if (( FAST_WORKERS>0 )); then
  [[ -n "$FAST_WORKER_URL" ]] || { echo "AUTOMATION_WORKER_URL is required for fast verified-stock workers" >&2; exit 1; }
fi

main_matches_target(){
  [[ "$(docker inspect "$CONTAINER" --format '{{index .Config.Labels "auditseo.verified-stock.sha"}}' 2>/dev/null || true)" == "$SHA" ]] &&
  [[ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] &&
  [[ "$(docker inspect "$CONTAINER" --format '{{.HostConfig.Memory}}' 2>/dev/null || true)" == "$TARGET_MEMORY" ]] &&
  [[ "$(docker inspect "$CONTAINER" --format '{{.HostConfig.NanoCpus}}' 2>/dev/null || true)" == "$TARGET_CPUS" ]]
}

fast_matches_target(){
  local name="$1"
  [[ "$(docker inspect "$name" --format '{{index .Config.Labels "auditseo.verified-stock-fast.sha"}}' 2>/dev/null || true)" == "$SHA" ]] &&
  [[ "$(docker inspect "$name" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] &&
  [[ "$(docker inspect "$name" --format '{{.HostConfig.Memory}}' 2>/dev/null || true)" == "$FAST_MEMORY" ]] &&
  [[ "$(docker inspect "$name" --format '{{.HostConfig.NanoCpus}}' 2>/dev/null || true)" == "$FAST_CPUS" ]]
}

wait_running(){
  local name="$1"
  for _ in $(seq 1 30); do
    [[ "$(docker inspect "$name" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] && return 0
    sleep 0.5
  done
  docker logs "$name" --tail 100 || true
  return 1
}

mkdir -p "$WORK_DIR"
chown 1001:1001 "$WORK_DIR"

if ! main_matches_target; then
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d \
    --name "$CONTAINER" \
    --restart unless-stopped \
    --env-file "$ENV_FILE" \
    --network cacadores-infra \
    -e VERIFIED_STOCK_WORKER_URL=http://127.0.0.1:3000/ \
    --memory 2g \
    --cpus 1 \
    --pids-limit 512 \
    -v "$WORK_DIR:/tmp" \
    --label auditseo.role=verified-stock-worker \
    --label "auditseo.verified-stock.sha=$SHA" \
    "$IMAGE" node scripts/verified-stock-supervisor.mjs >/dev/null
  wait_running "$CONTAINER"
fi

for i in $(seq 1 "$FAST_WORKERS"); do
  name="$PROJECT-stock-fast-$i"
  if fast_matches_target "$name"; then
    continue
  fi
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d \
    --name "$name" \
    --restart unless-stopped \
    --env-file "$ENV_FILE" \
    --network cacadores-infra \
    -e VERIFIED_STOCK_WORKER_URL="$FAST_WORKER_URL" \
    -e VERIFIED_STOCK_WORKER_POLL_MS=3000 \
    -e VERIFIED_STOCK_WORKER_DRAIN_YIELD_MS=75 \
    --memory 320m \
    --cpus 0.35 \
    --pids-limit 128 \
    --label auditseo.role=verified-stock-fast-worker \
    --label "auditseo.verified-stock-fast.sha=$SHA" \
    "$IMAGE" node scripts/verified-stock-worker.mjs >/dev/null
  wait_running "$name"
done

while read -r name; do
  [[ -n "$name" ]] || continue
  suffix="${name##*-}"
  if [[ "$suffix" =~ ^[0-9]+$ ]] && (( suffix>FAST_WORKERS )); then
    docker rm -f "$name" >/dev/null 2>&1 || true
  fi
done < <(docker ps -a --format '{{.Names}}' | grep "^$PROJECT-stock-fast-[0-9]\+$" || true)

python3 - "$WORKER_STATE" "$SHA" "$IMAGE" "$FAST_WORKERS" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({
  "sha":sys.argv[2],
  "image":sys.argv[3],
  "container":"cacador-de-nicho-verified-stock-worker",
  "memoryBytes":2147483648,
  "nanoCpus":1000000000,
  "fastWorkers":int(sys.argv[4]),
  "fastWorkerMemoryBytes":335544320,
  "fastWorkerNanoCpus":350000000,
  "syncedAt":datetime.datetime.now(datetime.timezone.utc).isoformat()
},indent=2)+"\n")
PY

echo "VERIFIED_STOCK_WORKERS_SYNCED sha=$SHA image=$IMAGE main=1 fast=$FAST_WORKERS"
