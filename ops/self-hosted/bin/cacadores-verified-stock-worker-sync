#!/usr/bin/env bash
set -euo pipefail

BASE=/srv/auditseo-deploy
PROJECT=cacador-de-nicho
STATE_FILE="$BASE/state/$PROJECT.json"
WORKER_STATE="$BASE/state/$PROJECT-verified-stock-worker.json"
ENV_FILE="$BASE/env/$PROJECT.production.env"
WORK_DIR="$BASE/work/$PROJECT-verified-stock"
CONTAINER="$PROJECT-verified-stock-worker"
LOCK_DIR="$BASE/state/.cacadores-verified-stock-worker-sync.lock"

TARGET_MEMORY=805306368
TARGET_CPUS=500000000
FAST_MEMORY=268435456
FAST_CPUS=250000000
FAST_WORKERS="${VERIFIED_STOCK_FAST_WORKERS:-1}"
DRAIN_FILE="${VERIFIED_STOCK_WORKER_DRAIN_FILE:-/tmp/cacadores-verified-stock-drain}"
DRAIN_WAIT_SECONDS="${VERIFIED_STOCK_WORKER_DRAIN_WAIT_SECONDS:-8}"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" >/dev/null 2>&1 || true' EXIT

readarray -t VALUES < <(python3 - "$STATE_FILE" "$ENV_FILE" <<'PY'
from pathlib import Path
import json,sys
s=json.loads(Path(sys.argv[1]).read_text())
prod=s.get("production") or {}
env={}
for raw in Path(sys.argv[2]).read_text().splitlines():
    line=raw.strip()
    if not line or line.startswith("#") or "=" not in line:
        continue
    key,value=line.split("=",1)
    env[key.strip()]=value.strip()
print(prod.get("sha",""))
print(prod.get("image",""))
print(env.get("AUTOMATION_WORKER_URL",""))
PY
)
SHA="${VALUES[0]:-}"
IMAGE="${VALUES[1]:-}"
FAST_WORKER_URL="${VALUES[2]:-}"
[[ -n "$SHA" && -n "$IMAGE" ]] || { echo "production state incomplete" >&2; exit 1; }
[[ "$FAST_WORKERS" =~ ^[0-9]+$ ]] || { echo "VERIFIED_STOCK_FAST_WORKERS must be an integer" >&2; exit 1; }
(( FAST_WORKERS>=0 && FAST_WORKERS<=8 )) || { echo "VERIFIED_STOCK_FAST_WORKERS must be between 0 and 8" >&2; exit 1; }
[[ "$DRAIN_WAIT_SECONDS" =~ ^[0-9]+$ ]] || { echo "VERIFIED_STOCK_WORKER_DRAIN_WAIT_SECONDS must be an integer" >&2; exit 1; }
(( DRAIN_WAIT_SECONDS>=1 && DRAIN_WAIT_SECONDS<=30 )) || { echo "VERIFIED_STOCK_WORKER_DRAIN_WAIT_SECONDS must be between 1 and 30" >&2; exit 1; }
if (( FAST_WORKERS>0 )); then
  [[ -n "$FAST_WORKER_URL" ]] || { echo "AUTOMATION_WORKER_URL is required for fast verified-stock workers" >&2; exit 1; }
fi

main_drain_marker_path(){
  [[ "$DRAIN_FILE" == /tmp/* ]] || return 1
  printf '%s/%s\n' "$WORK_DIR" "${DRAIN_FILE#/tmp/}"
}

main_drain_marker_present(){
  local marker
  marker="$(main_drain_marker_path 2>/dev/null || true)"
  [[ -n "$marker" && -e "$marker" ]]
}

clear_main_drain_marker(){
  local marker
  marker="$(main_drain_marker_path 2>/dev/null || true)"
  [[ -n "$marker" ]] && rm -f -- "$marker"
}

main_matches_target(){
  [[ "$(docker inspect "$CONTAINER" --format '{{index .Config.Labels "auditseo.verified-stock.sha"}}' 2>/dev/null || true)" == "$SHA" ]] &&
  [[ "$(docker inspect "$CONTAINER" --format '{{.State.Status}}' 2>/dev/null || true)" == "running" ]] &&
  ! main_drain_marker_present &&
  [[ "$(docker inspect "$CONTAINER" --format '{{.HostConfig.Memory}}' 2>/dev/null || true)" == "$TARGET_MEMORY" ]] &&
  [[ "$(docker inspect "$CONTAINER" --format '{{.HostConfig.NanoCpus}}' 2>/dev/null || true)" == "$TARGET_CPUS" ]]
}

fast_matches_target(){
  local name="$1"
  [[ "$(docker inspect "$name" --format '{{index .Config.Labels "auditseo.verified-stock-fast.sha"}}' 2>/dev/null || true)" == "$SHA" ]] &&
  [[ "$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null || true)" == "running" ]] &&
  [[ "$(docker inspect "$name" --format '{{.HostConfig.Memory}}' 2>/dev/null || true)" == "$FAST_MEMORY" ]] &&
  [[ "$(docker inspect "$name" --format '{{.HostConfig.NanoCpus}}' 2>/dev/null || true)" == "$FAST_CPUS" ]]
}

wait_running(){
  local name="$1"
  local stable=0
  for _ in $(seq 1 40); do
    if [[ "$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null || true)" == "running" ]]; then
      stable=$((stable+1))
      (( stable>=4 )) && return 0
    else
      stable=0
    fi
    sleep 0.5
  done
  docker logs "$name" --tail 100 || true
  return 1
}

request_drain(){
  local name="$1"
  local status
  status="$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null || true)"
  [[ -n "$status" ]] || return 0
  docker update --restart=no "$name" >/dev/null 2>&1 || true
  if [[ "$status" != "running" ]]; then
    docker stop -t 5 "$name" >/dev/null 2>&1 || true
    return 0
  fi
  docker exec "$name" sh -lc "touch '$DRAIN_FILE'" >/dev/null 2>&1 || true
  for _ in $(seq 1 $((DRAIN_WAIT_SECONDS*2))); do
    [[ "$(docker inspect "$name" --format '{{.State.Status}}' 2>/dev/null || true)" != "running" ]] && return 0
    sleep 0.5
  done
  return 1
}

remove_after_drain(){
  local name="$1"
  if ! request_drain "$name"; then
    echo "VERIFIED_STOCK_WORKER_DRAINING name=$name"
    return 1
  fi
  docker rm -f "$name" >/dev/null 2>&1 || true
  if [[ "$name" == "$CONTAINER" ]]; then
    clear_main_drain_marker
  fi
  return 0
}

mkdir -p "$WORK_DIR"
chown 1001:1001 "$WORK_DIR"

DEFERRED_WORKERS=0

if ! main_matches_target; then
  if remove_after_drain "$CONTAINER"; then
    docker run -d \
      --name "$CONTAINER" \
      --restart unless-stopped \
      --env-file "$ENV_FILE" \
      --network cacadores-infra \
      -e VERIFIED_STOCK_WORKER_URL=http://127.0.0.1:3000/ \
      -e VERIFIED_STOCK_WORKER_POLL_MS=15000 \
      --cgroup-parent=cacadores-workers.slice \
      --memory 768m \
      --memory-swap 896m \
      --cpus 0.5 \
      --pids-limit 256 \
      -v "$WORK_DIR:/tmp" \
      --label auditseo.role=verified-stock-worker \
      --label "auditseo.verified-stock.sha=$SHA" \
      "$IMAGE" node scripts/verified-stock-supervisor.mjs >/dev/null
    wait_running "$CONTAINER"
  else
    DEFERRED_WORKERS=$((DEFERRED_WORKERS+1))
  fi
fi

for i in $(seq 1 "$FAST_WORKERS"); do
  name="$PROJECT-stock-fast-$i"
  if fast_matches_target "$name"; then
    continue
  fi
  if remove_after_drain "$name"; then
    docker run -d \
      --name "$name" \
      --restart unless-stopped \
      --env-file "$ENV_FILE" \
      --network cacadores-infra \
      -e VERIFIED_STOCK_WORKER_URL="$FAST_WORKER_URL" \
      -e VERIFIED_STOCK_WORKER_POLL_MS=15000 \
      -e VERIFIED_STOCK_WORKER_DRAIN_YIELD_MS=250 \
      --cgroup-parent=cacadores-workers.slice \
      --memory 256m \
      --memory-swap 320m \
      --cpus 0.25 \
      --pids-limit 128 \
      --label auditseo.role=verified-stock-fast-worker \
      --label "auditseo.verified-stock-fast.sha=$SHA" \
      "$IMAGE" node scripts/verified-stock-worker.mjs >/dev/null
    wait_running "$name"
  else
    DEFERRED_WORKERS=$((DEFERRED_WORKERS+1))
  fi
done

while read -r name; do
  [[ -n "$name" ]] || continue
  suffix="${name##*-}"
  if [[ "$suffix" =~ ^[0-9]+$ ]] && (( suffix>FAST_WORKERS )); then
    if ! remove_after_drain "$name"; then
      DEFERRED_WORKERS=$((DEFERRED_WORKERS+1))
    fi
  fi
done < <(docker ps -a --format '{{.Names}}' | grep "^$PROJECT-stock-fast-[0-9]\+$" || true)

python3 - "$WORKER_STATE" "$SHA" "$IMAGE" "$FAST_WORKERS" "$DEFERRED_WORKERS" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({
  "sha":sys.argv[2],
  "image":sys.argv[3],
  "container":"cacador-de-nicho-verified-stock-worker",
  "memoryBytes":805306368,
  "nanoCpus":500000000,
  "fastWorkers":int(sys.argv[4]),
  "deferredWorkers":int(sys.argv[5]),
  "fastWorkerMemoryBytes":268435456,
  "fastWorkerNanoCpus":250000000,
  "syncedAt":datetime.datetime.now(datetime.timezone.utc).isoformat()
},indent=2)+"\n")
PY

if (( DEFERRED_WORKERS>0 )); then
  echo "VERIFIED_STOCK_WORKERS_DRAINING sha=$SHA image=$IMAGE deferred=$DEFERRED_WORKERS"
else
  echo "VERIFIED_STOCK_WORKERS_SYNCED sha=$SHA image=$IMAGE main=1 fast=$FAST_WORKERS"
fi
