#!/usr/bin/env bash
set -euo pipefail

BASE=/srv/auditseo-deploy
PROJECT=cacador-de-nicho
STATE_FILE="$BASE/state/$PROJECT.json"
WORKER_STATE="$BASE/state/$PROJECT-episode-automation-worker.json"
ENV_FILE="$BASE/env/$PROJECT.production.env"
WORK_DIR="$BASE/work/$PROJECT-episode-automation"
CONTAINER="$PROJECT-episode-automation-worker"
LOCK_DIR="$BASE/state/.cacadores-episode-automation-worker-sync.lock"

if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$LOCK_DIR" >/dev/null 2>&1 || true' EXIT

readarray -t VALUES < <(python3 - "$STATE_FILE" <<'PY'
from pathlib import Path
import json,sys
s=json.loads(Path(sys.argv[1]).read_text())
prod=s.get("production") or {}
print(prod.get("sha",""))
print(prod.get("image",""))
PY
)
SHA="${VALUES[0]:-}"
IMAGE="${VALUES[1]:-}"
[[ -n "$SHA" && -n "$IMAGE" ]] || { echo "production state incomplete" >&2; exit 1; }

CURRENT_SHA="$(docker inspect "$CONTAINER" --format '{{index .Config.Labels "auditseo.episode-automation.sha"}}' 2>/dev/null || true)"
RUNNING="$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)"
MEMORY="$(docker inspect "$CONTAINER" --format '{{.HostConfig.Memory}}' 2>/dev/null || true)"
CPUS="$(docker inspect "$CONTAINER" --format '{{.HostConfig.NanoCpus}}' 2>/dev/null || true)"

TARGET_MEMORY=1073741824
TARGET_CPUS=500000000

if [[ "$CURRENT_SHA" == "$SHA" && "$RUNNING" == "true" && "$MEMORY" == "$TARGET_MEMORY" && "$CPUS" == "$TARGET_CPUS" ]]; then
  exit 0
fi

mkdir -p "$WORK_DIR"
chown 1001:1001 "$WORK_DIR"
docker rm -f "$CONTAINER" >/dev/null 2>&1 || true

docker run -d \
  --name "$CONTAINER" \
  --restart unless-stopped \
  --env-file "$ENV_FILE" \
  --memory 1g \
  --cpus 0.5 \
  --pids-limit 256 \
  -v "$WORK_DIR:/tmp" \
  --label auditseo.role=episode-automation-worker \
  --label "auditseo.episode-automation.sha=$SHA" \
  "$IMAGE" node scripts/episode-automation-supervisor.mjs >/dev/null

for i in $(seq 1 30); do
  [[ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] && break
  sleep 0.5
done

[[ "$(docker inspect "$CONTAINER" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] || {
  docker logs "$CONTAINER" --tail 100 || true
  exit 1
}

python3 - "$WORKER_STATE" "$SHA" "$IMAGE" <<'PY'
from pathlib import Path
import json,sys,datetime
Path(sys.argv[1]).write_text(json.dumps({
  "sha":sys.argv[2],
  "image":sys.argv[3],
  "container":"cacador-de-nicho-episode-automation-worker",
  "memoryBytes":1073741824,
  "nanoCpus":500000000,
  "syncedAt":datetime.datetime.now(datetime.timezone.utc).isoformat()
},indent=2)+"\n")
PY

echo "EPISODE_AUTOMATION_WORKER_SYNCED sha=$SHA image=$IMAGE memory=1g cpus=0.5"
